APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Copy this file to .env. Keep credentials, Workspace ID, hostnames, and URLs
# only in the ignored .env; never commit or package those user-specific values.
# local | dashscope. For the verified production setup, set both to dashscope
# in .env while keeping this distributable example secret-free.
GENERATION_PROVIDER=local
GENERATION_MAX_ATTEMPTS=2
EMBEDDING_PROVIDER=local

# Local development and automated evaluation
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:27b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:4b

# Production on Alibaba Cloud Model Studio (Singapore workspace).
# User-specific values intentionally remain blank in this tracked example.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=ap-southeast-1
# Hostname only, without https://. The two explicit URLs below take precedence.
DASHSCOPE_API_HOST=
DASHSCOPE_COMPATIBLE_BASE_URL=
DASHSCOPE_NATIVE_BASE_URL=
DASHSCOPE_CHAT_MODEL=qwen3.7-flash-2026-07-15
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_DIMENSIONS=1024

# Non-realtime HTTP TTS; no offline speech fallback. Missing credentials return
# a visible service error.
TTS_PROVIDER=dashscope
DASHSCOPE_TTS_MODEL=qwen3-tts-flash-2025-11-27
DASHSCOPE_TTS_VOICE=Serena
DASHSCOPE_TTS_LANGUAGE=Chinese

KNOWLEDGE_MANIFEST=knowledge/sources.json
RAG_INDEX_PATH=.data/index.sqlite
RETRIEVAL_TOP_K=6
RETRIEVAL_VECTOR_THRESHOLD=0.52
RETRIEVAL_LEXICAL_THRESHOLD=0.08
RETRIEVAL_ALLOW_LEXICAL_FALLBACK=false
STRICT_GROUNDING_VERIFICATION=true
